        <mxCell id="m14" value="COMPLETE_JOB 101" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.7806;entryX=0;entryY=0.0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243247;fontSize=15;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="worker-process" target="act7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m15" value="completeJob(101) → release()" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.3333;entryX=0;entryY=0.0;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243247;fontSize=15;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="act7" target="act6">
          <mxGeometry relative="1" as="geometry" />
