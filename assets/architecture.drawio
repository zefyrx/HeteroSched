        <mxCell data-kind="annotation" id="sequence-title" value="&lt;b&gt;HeteroSched · Worker 注册、领取与完成&lt;/b&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243247;fontSize=30;">
          <mxGeometry x="60" y="30" width="1760" height="60" as="geometry" />
        </mxCell>
        <mxCell data-kind="annotation" id="sequence-subtitle" value="成功路径示例 · Worker 每次请求使用独立短连接 · 资源预留与领取在同一把 Scheduler mutex 下记账" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243247;fontSize=16;">
          <mxGeometry x="60" y="100" width="1760" height="45" as="geometry" />
        </mxCell>
        <mxCell data-kind="annotation" id="sequence-limit" value="&lt;b&gt;边界与失败&lt;/b&gt;　NO_JOB 时 Worker 等待 1 秒再领取；一次全局调度也可能把任务分给其他 Worker。&lt;br&gt;资源预留不等于已经执行；响应丢失 / Worker 崩溃不自动回滚，不保证端到端 exactly-once。" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243247;fontSize=16;">
          <mxGeometry x="60" y="1470" width="1760" height="85" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="epoll-detail" name="03 LT epoll 连接处理">
    <mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1240" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
