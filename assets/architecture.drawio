        <mxCell id="epoll-detail--output-buffer" value="&lt;b&gt;积累响应&lt;/b&gt;&lt;br&gt;&lt;br&gt;output += handler_(line)&lt;br&gt;pending = size − offset&lt;br&gt;按请求顺序保留待发数据" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=14;strokeWidth=1.5;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243247;" vertex="1" parent="1" data-model-id="output-buffer" data-kind="module" data-properties="{&quot;role&quot;:&quot;queue&quot;,&quot;status&quot;:&quot;implemented&quot;}" data-source-properties="{&quot;role&quot;:&quot;queue&quot;,&quot;status&quot;:&quot;implemented&quot;}" data-source-label="&lt;b&gt;积累响应&lt;/b&gt;&lt;br&gt;&lt;br&gt;output += handler_(line)&lt;br&gt;pending = size − offset&lt;br&gt;按请求顺序保留待发数据" data-provenance="{&quot;path&quot;:&quot;src/net/epoll_server.cpp&quot;,&quot;line&quot;:111}">
