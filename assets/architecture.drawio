        <mxCell id="epoll-detail--request-handler" value="&lt;b&gt;handler(line)&lt;/b&gt;&lt;br&gt;&lt;br&gt;processSchedulerRequest()&lt;br&gt;同步调用 Scheduler&lt;br&gt;返回带换行的响应" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=14;strokeWidth=1.5;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243247;" vertex="1" parent="1" data-model-id="request-handler" data-kind="module" data-properties="{&quot;role&quot;:&quot;protocol&quot;,&quot;status&quot;:&quot;implemented&quot;}" data-source-properties="{&quot;role&quot;:&quot;protocol&quot;,&quot;status&quot;:&quot;implemented&quot;}" data-source-label="&lt;b&gt;handler(line)&lt;/b&gt;&lt;br&gt;&lt;br&gt;processSchedulerRequest()&lt;br&gt;同步调用 Scheduler&lt;br&gt;返回带换行的响应" data-provenance="{&quot;path&quot;:&quot;apps/scheduler_server_epoll.cpp&quot;,&quot;line&quot;:14}">
