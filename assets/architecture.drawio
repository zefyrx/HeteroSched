        <mxCell id="core" value="Scheduler (mutex)&lt;br&gt;FirstFit / BinPack / LeastAllocated" vertex="1" parent="server" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;">
          <mxGeometry x="260" y="400" width="500" height="90" as="geometry" />
