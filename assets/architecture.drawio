<mxfile host="app.diagrams.net" type="device">
  <diagram id="heterosched-architecture" name="Architecture">
    <mxGraphModel dx="1100" dy="1100" grid="1" gridSize="10" page="1" pageWidth="1100" pageHeight="1100" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="clients" value="TCP clients&lt;br&gt;job_client / scheduler_client / worker_client" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;">
          <mxGeometry x="280" y="30" width="540" height="80" as="geometry" />
        </mxCell>
        <mxCell id="server" value="Scheduler process — choose one TCP entry point" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlane;startSize=40;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;container=1;pointerEvents=0;">
          <mxGeometry x="40" y="180" width="1020" height="820" as="geometry" />
        </mxCell>
        <mxCell id="blocking" value="scheduler_server&lt;br&gt;blocking: one request per connection" vertex="1" parent="server" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;">
          <mxGeometry x="40" y="70" width="380" height="80" as="geometry" />
