        <mxCell data-kind="annotation" id="epoll-detail-title" value="&lt;b&gt;HeteroSched · LT epoll 连接与字节流&lt;/b&gt;" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243247;fontSize=30;">
          <mxGeometry x="60" y="35" width="1560" height="60" as="geometry" />
        </mxCell>
        <mxCell data-kind="annotation" id="epoll-detail-subtitle" value="单线程事件循环 · 非阻塞 socket · 业务同步执行 · LT 公平性预算" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243247;fontSize=16;">
          <mxGeometry x="60" y="110" width="1560" height="45" as="geometry" />
        </mxCell>
        <mxCell data-kind="annotation" id="epoll-backpressure" value="&lt;b&gt;输出背压&lt;/b&gt;&lt;br&gt;待发数据达到 64 KiB 高水位时，&lt;br&gt;暂停读入与解析；写出后恢复。&lt;br&gt;高水位不是全局内存硬上限。" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243247;fontSize=16;">
          <mxGeometry x="530" y="850" width="330" height="180" as="geometry" />
        </mxCell>
        <mxCell data-kind="annotation" id="epoll-options" value="图示为读入到响应的简化路径；EPOLLOUT 可直接继续写。RDHUP 后仍需读完剩余数据并尝试发送响应。&lt;br&gt;可选 idle timeout / max connections 默认关闭。" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243247;fontSize=15;">
          <mxGeometry x="60" y="1100" width="1550" height="65" as="geometry" />
        </mxCell>
        <mxCell data-kind="annotation" id="epoll-detail-legend" value="&lt;font color=&quot;#6c8ebf&quot;&gt;■&lt;/font&gt; I/O 控制　 &lt;font color=&quot;#d79b00&quot;&gt;■&lt;/font&gt; 协议业务　 &lt;font color=&quot;#d6b656&quot;&gt;■&lt;/font&gt; 待发响应　 &lt;font color=&quot;#82b366&quot;&gt;■&lt;/font&gt; 连接状态" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243247;fontSize=15;">
          <mxGeometry x="60" y="1185" width="1560" height="35" as="geometry" />
        </mxCell>
        <mxCell id="epoll-detail--event-wait" value="&lt;b&gt;LT 事件循环&lt;/b&gt;&lt;br&gt;&lt;br&gt;epoll_wait() → pollOnce()&lt;br&gt;token = 0：监听 socket&lt;br&gt;其余 token：查找连接状态" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=14;strokeWidth=1.5;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243247;" vertex="1" parent="1" data-model-id="event-wait" data-kind="module" data-properties="{&quot;role&quot;:&quot;control&quot;,&quot;status&quot;:&quot;implemented&quot;}" data-source-properties="{&quot;role&quot;:&quot;control&quot;,&quot;status&quot;:&quot;implemented&quot;}" data-source-label="&lt;b&gt;LT 事件循环&lt;/b&gt;&lt;br&gt;&lt;br&gt;epoll_wait() → pollOnce()&lt;br&gt;token = 0：监听 socket&lt;br&gt;其余 token：查找连接状态" data-provenance="{&quot;path&quot;:&quot;src/net/epoll_server.cpp&quot;,&quot;line&quot;:226}">
          <mxGeometry x="80" y="240" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="epoll-detail--accept-ready" value="&lt;b&gt;acceptReady()&lt;/b&gt;&lt;br&gt;&lt;br&gt;accept4(NONBLOCK | CLOEXEC)&lt;br&gt;注册 EPOLLIN | EPOLLRDHUP&lt;br&gt;每轮最多 accept 64 次" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=14;strokeWidth=1.5;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243247;" vertex="1" parent="1" data-model-id="accept-ready" data-kind="module" data-properties="{&quot;role&quot;:&quot;control&quot;,&quot;status&quot;:&quot;implemented&quot;}" data-source-properties="{&quot;role&quot;:&quot;control&quot;,&quot;status&quot;:&quot;implemented&quot;}" data-source-label="&lt;b&gt;acceptReady()&lt;/b&gt;&lt;br&gt;&lt;br&gt;accept4(NONBLOCK | CLOEXEC)&lt;br&gt;注册 EPOLLIN | EPOLLRDHUP&lt;br&gt;每轮最多 accept 64 次" data-provenance="{&quot;path&quot;:&quot;src/net/epoll_server.cpp&quot;,&quot;line&quot;:66}">
          <mxGeometry x="80" y="510" width="300" height="180" as="geometry" />
        </mxCell>
        <mxCell id="epoll-detail--connection-state" value="&lt;b&gt;每连接 Connection 状态&lt;/b&gt;&lt;br&gt;&lt;br&gt;connections_：token → Connection&lt;br&gt;UniqueFd / input / output&lt;br&gt;outputOffset / interests&lt;br&gt;readClosed / closing / lastActivity&lt;br&gt;递增 token 避免旧事件误用复用 fd" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=14;strokeWidth=1.5;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243247;" vertex="1" parent="1" data-model-id="connection-state" data-kind="module" data-properties="{&quot;role&quot;:&quot;state&quot;,&quot;status&quot;:&quot;implemented&quot;}" data-source-properties="{&quot;role&quot;:&quot;state&quot;,&quot;status&quot;:&quot;implemented&quot;}" data-source-label="&lt;b&gt;每连接 Connection 状态&lt;/b&gt;&lt;br&gt;&lt;br&gt;connections_：token → Connection&lt;br&gt;UniqueFd / input / output&lt;br&gt;outputOffset / interests&lt;br&gt;readClosed / closing / lastActivity&lt;br&gt;递增 token 避免旧事件误用复用 fd" data-provenance="{&quot;path&quot;:&quot;include/net/epoll_server.h&quot;,&quot;line&quot;:31}">
