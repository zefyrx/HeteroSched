        </mxCell>
        <mxCell id="epoll-detail--read-ready" value="&lt;b&gt;service() / readReady()&lt;/b&gt;&lt;br&gt;&lt;br&gt;有读事件时 recv() → input&lt;br&gt;EAGAIN / EOF / 预算控制&lt;br&gt;每轮读预算 64 KiB" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=14;strokeWidth=1.5;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#243247;" vertex="1" parent="1" data-model-id="read-ready" data-kind="module" data-properties="{&quot;role&quot;:&quot;control&quot;,&quot;status&quot;:&quot;implemented&quot;}" data-source-properties="{&quot;role&quot;:&quot;control&quot;,&quot;status&quot;:&quot;implemented&quot;}" data-source-label="&lt;b&gt;service() / readReady()&lt;/b&gt;&lt;br&gt;&lt;br&gt;有读事件时 recv() → input&lt;br&gt;EAGAIN / EOF / 预算控制&lt;br&gt;每轮读预算 64 KiB" data-provenance="{&quot;path&quot;:&quot;src/net/epoll_server.cpp&quot;,&quot;line&quot;:115}">
